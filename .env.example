# Copy to .env and fill locally. Never commit .env.

DATABASE_URL=postgresql+psycopg://traj:traj@localhost:5432/traj
CREDENTIAL_MASTER_KEY=
# Required. The API refuses to start without it unless TRAJ_DEV_MODE=1.
JWT_SECRET=
# TRAJ_DEV_MODE=1
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Platform judge. The secret belongs only in .env.
# The engine origin, without /v1, such as https://engine.example.com
INFERENCE_ENGINE_BASE_URL=
INFERENCE_ENGINE_API_KEY=
INFERENCE_ENGINE_TENANT=domain-trajectory-data-generation
INFERENCE_ENGINE_ORG_ID=org-trajdata
INFERENCE_ENGINE_KEY_ID=domain-trajectory-data-generation-primary
INFERENCE_ENGINE_JUDGE_MODEL=qwen3.8:27b
# The second opinion for agreement; leave it empty to judge with the primary model alone.
INFERENCE_ENGINE_SECOND_JUDGE_MODEL=gemma4:26b
# Journeys judged per cycle, and the prompt budget per journey (the engine serves a 32k window).
# JUDGE_SAMPLE_SIZE=6
# JUDGE_PROMPT_TOKENS=8000
# Warm-start text the judge's brief carries, chosen by relevance to the study.
# JUDGE_REFERENCE_CHARS=6000

# Fetching warm-start links. A GitHub token only raises the API rate limit; it is sent to GitHub alone.
# GITHUB_TOKEN=
# FETCH_USER_AGENT=trajectory-studio/0.1 (warm-start fetcher; +https://example.com/contact)

NEXT_PUBLIC_API_URL=http://localhost:8000

# Daily limits for demo accounts over a rolling 24 hours. Admin and user accounts have none.
# DEMO_RUNS_PER_DAY=10
# DEMO_MAX_SEQUENCES=2000
# DEMO_JUDGE_CYCLES_PER_DAY=10
# DEMO_DEEP_SEARCHES_PER_DAY=3

# Optional overrides for provider web search and key checks. Defaults are the public APIs.
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_SEARCH_MODEL=gpt-5.5
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_SEARCH_MODEL=claude-sonnet-4-5
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com
# GOOGLE_SEARCH_MODEL=gemini-2.5-flash
# XAI_BASE_URL=https://api.x.ai
# XAI_SEARCH_MODEL=grok-4.5
